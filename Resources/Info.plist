<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleExecutable</key>
	<string>Chelka</string>
	<key>CFBundleIdentifier</key>
	<string>com.ivan.chelka</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Chelka</string>
	<key>CFBundleDisplayName</key>
	<string>Chelka</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Приложение живёт в меню-баре: без иконки в доке и без переключателя приложений. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Без этого ключа обращение к EventKit не просто отказывает,
	     а роняет приложение при первом же запросе доступа. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Чтобы показывать сегодняшние встречи прямо в вырезе. Данные никуда не отправляются и остаются на этом Mac.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Чтобы показывать сегодняшние встречи прямо в вырезе. Данные никуда не отправляются и остаются на этом Mac.</string>
	<!-- Тот же случай, что и с календарём: без ключа обращение к IOBluetooth
	     не отказывает, а убивает приложение на месте (TCC, SIGABRT). -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Чтобы показать заряд наушников, когда вы их подключаете. Само подключение и звук виджет не трогает.</string>
	<!-- Управление плеерами и чтение вкладки браузера идут через Apple Events. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Чтобы показывать текущий трек и переключать его в Music, Spotify и браузере.</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
